#  
# Snakemake
#  
.snakemake/
.snakemake.log
*.snakemake.log

#  
# Pipeline outputs (regenerable; don't commit)
#  
results/
logs/
benchmarks/
data/
fastq/
trimmed/
bams/
counts/

#  
# Conda / virtualenv
#  
.conda/
envs/.installed/
.venv/
venv/
env/

#  
# Python
#  
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

#  
# R
#  
.Rhistory
.Rapp.history
.RData
.Ruserdata
*.Rproj.user/
*.Rproj
.Rcheck/
*-Ex.R

#  
# Bioinformatics intermediates (in case something escapes results/)
#  
*.bam
*.bai
*.sam
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bedGraph
*.bigWig
*.bw
*.vcf
*.vcf.gz
